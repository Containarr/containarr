{
  "name": "@containarr/containarr",
  "version": "0.62.0",
  "scripts": {
    "test": "node --test",
    "serve:frontend": "npm --prefix frontend run dev -- --host",
    "start": "DEBUG=HTTPServer,Traefik,Docker,Settings,SQLite,DDNS,LetsEncrypt,Apps,App:*,Proxies,Updates,Backups,Events node server.mjs",
    "serve": "DEBUG=HTTPServer,Traefik,Docker,Settings,SQLite,DDNS,LetsEncrypt,Apps,App:*,Proxies,Updates,Backups,Events node --watch --watch-kill-signal SIGINT server.mjs",
    "start:docker": "docker compose -f docker-compose.yml up",
    "serve:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "build:docker": "docker build -t containarr ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@sequelize/sqlite3": "^7.0.0-alpha.48",
    "acme-client": "^5.4.0",
    "debug": "^4.4.3",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "markdown-it": "^15.0.1",
    "semver": "^7.8.5",
    "sequelize": "^6.37.8",
    "ssh2-sftp-client": "^12.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  }
}
